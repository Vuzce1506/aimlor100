					<string>#include &lt;iostream&gt;     // Thư viện in ra màn hình bằng cout
using namespace std;     // Giúp dùng cout, endl mà không cần std::

/*
    Hàm giới hạn giá trị tâm để tránh kéo quá mục tiêu (chống lố)
    float: kiểu dữ liệu số thực
    input: giá trị tọa độ ban đầu (x hoặc y)
    maxLimit: giới hạn tối đa cho phép (ví dụ: không kéo quá 50 pixel)
*/
float fixOvershoot(float input, float maxLimit) {
    // Nếu giá trị vượt quá giới hạn, thì trả về giới hạn
    if (input &gt; maxLimit)
        return maxLimit;

    // Ngược lại, nếu chưa vượt thì cứ giữ nguyên
    return input;
}

// Hàm in kết quả toạ độ sau khi chống lố
void printFixedOvershoot(float x, float y) {
    cout &lt;&lt; &quot;Toạ độ sau khi fix lố: (&quot; &lt;&lt; x &lt;&lt; &quot;, &quot; &lt;&lt; y &lt;&lt; &quot;)&quot; &lt;&lt; endl;
}

// Hàm chính – chương trình chạy bắt đầu từ đây
int main() {
    // Tọa độ tâm bị lệch do kéo quá mạnh (giả lập)
    float rawX = 50.0f;      // Trục X bị vượt giới hạn
    float rawY = 50.0f;      // Trục Y trong phạm vi cho phép

    // Giới hạn tối đa không cho tâm vượt quá
    float maxLimit = 50.0f;

    // Chống lố: nếu vượt thì ép về mức tối đa
    float fixedX = fixOvershoot(rawX, maxLimit);
    float fixedY = fixOvershoot(rawY, maxLimit);

    // In ra kết quả
    printFixedOvershoot(fixedX, fixedY);

    return 0; // Chương trình kết thúc OK
}</string>
