					<string>#include &lt;iostream&gt;     // Thư viện để dùng cout in ra màn hình
using namespace std;     // Cho phép viết cout thay vì std::cout

// Hàm tăng độ hút của tâm vào đầu đối thủ
// float là kiểu dữ liệu số thực, có phần thập phân (như 1.5, 2.75...)
float applyHeadLock(float input, float lockStrength) {
    // input: là toạ độ gốc (trục X hoặc Y)
    // lockStrength: là mức độ hút đầu (tăng càng mạnh thì kéo tâm càng gần đầu)
    // return: trả lại toạ độ đã được kéo gần về đầu hơn
    return input + lockStrength;
}

// Hàm in ra kết quả sau khi đã bám đầu
// void: kiểu hàm không trả lại gì, chỉ dùng để thực hiện hành động (in ra màn hình)
void printHeadLockedCoordinates(float x, float y) {
    cout &lt;&lt; &quot;Toạ độ sau khi bám đầu: (&quot; &lt;&lt; x &lt;&lt; &quot;, &quot; &lt;&lt; y &lt;&lt; &quot;)&quot; &lt;&lt; endl;
}

// int main: hàm chính của chương trình, bắt buộc phải có khi viết C++
// int: nghĩa là hàm sẽ trả về số nguyên, thường là 0 (return 0;)
int main() {
    // Tạo toạ độ gốc trước khi bám đầu (giả lập)
    float rawX = 10.0f; // toạ độ X ban đầu
    float rawY = 10.0f; // toạ độ Y ban đầu

    // Mức độ hút đầu – số càng cao thì tâm càng bám mạnh
    float lockStrength = 999.0f;

    // Gọi hàm applyHeadLock để tính toạ độ mới sau khi bám đầu
    float lockedX = applyHeadLock(rawX, lockStrength);
    float lockedY = applyHeadLock(rawY, lockStrength);

    // Gọi hàm in kết quả
    printHeadLockedCoordinates(lockedX, lockedY);

    // return 0: báo cho hệ điều hành biết là chương trình chạy xong OK
    return 0;
}</string>
