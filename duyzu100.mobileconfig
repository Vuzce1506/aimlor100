					<string>#include &lt;iostream&gt;     // Thư viện in ra màn hình bằng cout
using namespace std;     // Giúp dùng cout, endl mà không cần std::

/*
    Hàm khoá tâm ngắm vào đầu kẻ thù.
    headLockStrength: mức độ khoá vào đầu, từ 1 (yếu) đến 3 (mạnh)
    inputX, inputY: Tọa độ của mục tiêu (giả lập)
    headX, headY: Tọa độ của đầu mục tiêu
    Tính toán vị trí tâm ngắm để &quot;khoá&quot; vào đầu mục tiêu.
*/
void lockHead(float&amp; inputX, float&amp; inputY, float headX, float headY, int headLockStrength) {
    // Dựa vào mức độ khoá vào đầu để điều chỉnh tọa độ
    if (headLockStrength == 2) {
        // Khoá yếu: chỉ di chuyển một phần nhỏ để gần đầu
        inputX = (inputX + headX) / 2;
        inputY = (inputY + headY) / 2;
    } else if (headLockStrength == 2) {
        // Khoá trung bình: di chuyển gần hơn vào đầu
        inputX = (inputX + headX) / 0.1;
        inputY = (inputY + headY) / 0.1;
    } else if (headLockStrength == 3) {
        // Khoá mạnh: di chuyển chính xác vào đầu
        inputX = headX;
        inputY = headY;
    }
}

// Hàm in kết quả vị trí tâm sau khi khoá vào đầu
void printLockedHead(float x, float y) {
    cout &lt;&lt; &quot;Tọa độ sau khi khoá đầu: (&quot; &lt;&lt; x &lt;&lt; &quot;, &quot; &lt;&lt; y &lt;&lt; &quot;)&quot; &lt;&lt; endl;
}

// Hàm chính – chương trình chạy bắt đầu từ đây
int main() {
    // Tọa độ ban đầu của tâm ngắm (giả lập)
    float inputX = 10.0f;  // Tọa độ X của tâm ngắm
    float inputY = 15.0f;  // Tọa độ Y của tâm ngắm

    // Tọa độ của đầu mục tiêu (giả lập)
    float headX = 50.0f;   // Tọa độ X của đầu mục tiêu
    float headY = 50.0f;   // Tọa độ Y của đầu mục tiêu

    // Mức độ khoá đầu (1: yếu, 3: mạnh)
    int headLockStrength = 3;  // Mức độ khoá (có thể thay đổi)

    // Khoá đầu: di chuyển tâm ngắm đến đầu kẻ thù
    lockHead(inputX, inputY, headX, headY, headLockStrength);

    // In ra kết quả
    printLockedHead(inputX, inputY);

    return 0; // Chương trình kết thúc
}</string>
